# LaBio Media backend environment template
# Production-oriented template for Render. Never commit real secret values.
# For local development use DJANGO_ENV=development and localhost origins/URLs.

DJANGO_ENV=production
SECRET_KEY=
DEBUG=False
DATABASE_URL=

# Comma-separated. Production should include api.labiomedia.com and the
# Render service hostname used for health checks and rollback access.
ALLOWED_HOSTS=api.labiomedia.com,labio-backend.onrender.com
CORS_ALLOWED_ORIGINS=https://labiomedia.com,https://www.labiomedia.com
CSRF_TRUSTED_ORIGINS=https://api.labiomedia.com,https://labiomedia.com,https://www.labiomedia.com

# Production defaults are secure when DJANGO_ENV=production. Keep the proxy
# setting enabled on Render so Django recognizes the original HTTPS scheme.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
TRUST_X_FORWARDED_PROTO=True
# Start with a short value after HTTPS is verified, then increase deliberately.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Temporary synchronous proxy-upload ceiling, not a ProjectFile schema limit.
PROJECT_FILE_PROXY_UPLOAD_MAX_BYTES=100000000

# Public contact-form throttle. Render is the single trusted API proxy.
CONTACT_SUBMISSION_RATE_LIMIT=5
CONTACT_SUBMISSION_RATE_WINDOW_SECONDS=900
DRF_NUM_PROXIES=1

INVITATION_FRONTEND_URL=https://labiomedia.com/accept-invitation
INVITATION_TIMEOUT_SECONDS=259200
WAGTAILADMIN_BASE_URL=https://api.labiomedia.com

# Dedicated public CMS media storage. This is separate from protected
# Cloudinary ProjectFiles and is required in production.
CMS_MEDIA_ACCESS_KEY_ID=
CMS_MEDIA_SECRET_ACCESS_KEY=
CMS_MEDIA_BUCKET_NAME=
CMS_MEDIA_REGION_NAME=
CMS_MEDIA_ENDPOINT_URL=
CMS_MEDIA_CUSTOM_DOMAIN=

# Resend. EMAIL_FROM must use a verified sending domain in production.
# Choose the production mailbox/local-part before configuring Render.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=
